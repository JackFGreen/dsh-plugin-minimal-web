{
  "name": "dsh-plugin-minimal-web",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./host-apiproxy": {
      "default": "./lib/host-apiproxy.js"
    },
    "./host-webserver": {
      "default": "./lib/host-webserver.js"
    },
    "./client-connection": {
      "default": "./lib/client-connection.js"
    },
    "./client-modules": {
      "default": "./lib/client-modules.js"
    },
    "./host-frontend-static-minimal": {
      "default": "./lib/host-frontend-static-minimal.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*",
    "web/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm build:node && pnpm build:web",
    "build:node": "vite build --config vite.node.config.ts",
    "build:web": "pnpm --filter @minimal-web/client-web build:web",
    "prepack": "pnpm test && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
