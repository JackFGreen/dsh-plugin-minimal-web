{
  "name": "dsh-plugin-minimal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./host-apiproxy": {
      "types": "./packages/host-apiproxy/lib/types/index.d.ts",
      "default": "./packages/host-apiproxy/lib/types/index.js"
    },
    "./host-webserver": {
      "types": "./packages/host-webserver/lib/types/index.d.ts",
      "default": "./packages/host-webserver/lib/types/index.js"
    },
    "./client-connection": {
      "types": "./packages/client-connection/lib/types/index.d.ts",
      "default": "./packages/client-connection/lib/types/index.js"
    },
    "./client-runtime": {
      "types": "./packages/client-runtime/lib/types/index.d.ts",
      "default": "./packages/client-runtime/lib/types/index.js"
    },
    "./client-ui-slots": {
      "types": "./packages/client-ui-slots/lib/types/index.d.ts",
      "default": "./packages/client-ui-slots/lib/types/index.js"
    },
    "./client-ui-minimal-chat": {
      "types": "./packages/client-ui-minimal-chat/lib/types/index.d.ts",
      "default": "./packages/client-ui-minimal-chat/lib/types/index.js"
    },
    "./client-modules": {
      "types": "./packages/client-modules/lib/types/index.d.ts",
      "default": "./packages/client-modules/lib/types/index.js"
    },
    "./client-web": {
      "types": "./packages/client-web/lib/types/index.d.ts",
      "default": "./packages/client-web/lib/types/index.js"
    },
    "./host-frontend-static-minimal": {
      "types": "./packages/host-frontend-static-minimal/lib/types/index.d.ts",
      "default": "./packages/host-frontend-static-minimal/lib/types/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "packages/client-web/dist/**/*",
    "packages/*/lib/types/**/*.js",
    "packages/*/lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter @minimal-web/client-web build:web",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@minimal-web/client-connection": "workspace:*",
    "@minimal-web/client-modules": "workspace:*",
    "@minimal-web/client-runtime": "workspace:*",
    "@minimal-web/client-ui-minimal-chat": "workspace:*",
    "@minimal-web/client-ui-slots": "workspace:*",
    "@minimal-web/client-web": "workspace:*",
    "@minimal-web/host-frontend-static-minimal": "workspace:*",
    "@minimal-web/host-apiproxy": "workspace:*",
    "@minimal-web/host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
